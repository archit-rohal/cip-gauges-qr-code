/* GaugePage - Premium Control Design */

.gauge-page {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-secondary);
}

/* ====== HEADER SECTION ====== */
.gauge-page-header {
  flex-shrink: 0;
  padding: 1.5rem 2rem;
  border-bottom: 1px solid var(--border-color);
  background-color: var(--bg-secondary);
}

.gauge-page-header h1 {
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text-primary);
  margin: 0;
}

.gauge-page-header .accent {
  color: var(--accent-primary);
  font-weight: 700;
}

/* ====== NAVIGATION BUTTONS ====== */
.back-button,
.fullscreen-button {
  position: fixed;
  z-index: 50;
  width: 48px;
  height: 48px;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  color: var(--text-primary);
  font-size: 1.25rem;
  font-weight: 500;
  cursor: pointer;
  box-shadow: var(--shadow-sm);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  touch-action: manipulation;
}

.back-button:hover:not(:disabled),
.fullscreen-button:hover:not(:disabled) {
  background-color: var(--bg-tertiary);
  border-color: var(--accent-primary);
  box-shadow: var(--shadow-md);
}

.back-button:active:not(:disabled),
.fullscreen-button:active:not(:disabled) {
  transform: scale(0.96);
}

.back-button:disabled,
.fullscreen-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Back Button Position */
.back-button {
  top: 1rem;
  left: 1rem;
}

/* Fullscreen Button Position */
.fullscreen-button {
  top: 1rem;
  right: 1rem;
}

/* Fullscreen Active State */
.fullscreen-button.btn-icon--active {
  background-color: var(--accent-light);
  border-color: var(--accent-primary);
  color: var(--accent-primary);
}

/* Mobile adjustments */
@media (max-width: 640px) {
  .back-button,
  .fullscreen-button {
    width: 44px;
    height: 44px;
    font-size: 1.1rem;
    top: 0.75rem;
  }

  .back-button {
    left: 0.75rem;
  }

  .fullscreen-button {
    right: 0.75rem;
  }
}

/* ====== FULLSCREEN MODE ====== */
.gauge-page.fullscreen-mode {
  background-color: #000000;
}

.gauge-page.fullscreen-mode .gauge-page-header,
.gauge-page.fullscreen-mode .gauge-display-metadata,
.gauge-page.fullscreen-mode .back-button,
.gauge-page.fullscreen-mode .zoom-hint {
  display: none !important;
}

.gauge-page.fullscreen-mode .fullscreen-button {
  background-color: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
}

.gauge-page.fullscreen-mode .fullscreen-button:hover {
  background-color: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.3);
}
