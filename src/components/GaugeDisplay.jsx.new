import { useEffect, useState } from 'react';
import gaugesData from '../data/gauges.json';
import { useFullScreen } from '../context/FullScreenContext';
import NotFound from './NotFound';
import Loading from './Loading';
import { ZoomableImage } from './ZoomableImage';
import './GaugeDisplay.css';

/**
 * GaugeDisplay Component
 * 
 * Displays gauge information and image with premium full-screen viewing
 * 
 * Props:
 *   - partCode: The part code (e.g., 'EA2')
 *   - onNotFound: Optional callback when part is not found
 */
export function GaugeDisplay({ partCode, onNotFound }) {
  const [loading, setLoading] = useState(false);
  const [imageError, setImageError] = useState(false);
  const { isFullScreen } = useFullScreen();

  useEffect(() => {
    setLoading(false);
  }, [partCode]);

  if (loading) return <Loading />;

  if (!partCode || !gaugesData[partCode]) {
    if (onNotFound) onNotFound();
    return <NotFound partCode={partCode} />;
  }

  const gauge = gaugesData[partCode];

  return (
    <div className={`gauge-page ${isFullScreen ? 'fullscreen-mode' : ''}`}>
      {/* Header with Part Number */}
      {!isFullScreen && (
        <div className="gauge-page-header">
          <h1>
            PART <span className="accent">{partCode}</span>
          </h1>
        </div>
      )}

      {/* Content Area */}
      <div className="gauge-display-content">
        {/* Image Section - Primary Focus */}
        <div className="gauge-display-image-section">
          {imageError ? (
            <div className="gauge-display-error">
              <div className="gauge-display-error-icon">⚠</div>
              <h2 className="gauge-display-error-title">Image Not Available</h2>
              <p className="gauge-display-error-msg">
                The gauge list could not be loaded. Please try another part code.
              </p>
            </div>
          ) : (
            <div className="gauge-display-image-wrapper">
              <ZoomableImage
                src={gauge.image}
                alt={`Gauge list for part ${partCode}`}
                maxZoom={4}
              />
            </div>
          )}
        </div>

        {/* Metadata Section - Below Image */}
        {!isFullScreen && (
          <div className="gauge-display-metadata">
            {gauge.description && (
              <div className="gauge-display-description">
                <p>{gauge.description}</p>
              </div>
            )}

            {gauge.note && (
              <div className="gauge-display-note">
                <p className="gauge-display-note-title">⚡ Important</p>
                <p className="gauge-display-note-content">{gauge.note}</p>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}
