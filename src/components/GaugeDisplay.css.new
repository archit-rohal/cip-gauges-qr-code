/* GaugeDisplay - Premium Gauge Viewer */

.gauge-page {
  flex-direction: column;
  overflow: hidden;
}

/* ====== CONTENT AREA ====== */
.gauge-display-content {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* Image viewer section - main focus area */
.gauge-display-image-section {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 50vh;
}

.gauge-display-image-wrapper {
  width: 100%;
  max-width: 100%;
}

/* ====== ERROR STATE ====== */
.gauge-display-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 3rem 2rem;
  text-align: center;
}

.gauge-display-error-icon {
  font-size: 3rem;
  margin-bottom: 1.5rem;
  color: var(--text-tertiary);
}

.gauge-display-error-title {
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 0.75rem;
}

.gauge-display-error-msg {
  font-size: 1rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ====== METADATA SECTION ====== */
.gauge-display-metadata {
  flex-shrink: 0;
  padding: 2rem;
  background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%);
  border-top: 1px solid var(--border-color);
  overflow-y: auto;
}

/* Description */
.gauge-display-description {
  margin-bottom: 1.5rem;
  max-width: 100%;
}

.gauge-display-description p {
  font-size: 1rem;
  color: var(--text-secondary);
  line-height: 1.6;
  margin: 0;
}

/* ====== IMPORTANT NOTE / WARNING ====== */
.gauge-display-note {
  padding: 1rem 1.5rem;
  background-color: #FEF3C7;
  border-left: 4px solid #F59E0B;
  border-radius: 8px;
}

.gauge-display-note-title {
  font-size: 0.875rem;
  font-weight: 600;
  color: #92400E;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.gauge-display-note-content {
  font-size: 1rem;
  color: #B45309;
  line-height: 1.6;
  margin: 0;
}

/* ====== FULLSCREEN MODE ====== */
.gauge-page.fullscreen-mode {
  background-color: #000000;
}

.gauge-page.fullscreen-mode .gauge-display-header,
.gauge-page.fullscreen-mode .gauge-display-metadata {
  display: none;
}

.gauge-page.fullscreen-mode .gauge-display-image-section {
  min-height: 100vh;
  padding: 0;
}

/* ====== MOBILE OPTIMIZATIONS ====== */
@media (max-width: 640px) {
  .gauge-page-header {
    padding: 1rem 1rem;
  }

  .gauge-page-header h1 {
    font-size: 1.5rem;
  }

  .gauge-display-image-section {
    min-height: 40vh;
  }

  .gauge-display-metadata {
    padding: 1rem;
  }

  .gauge-display-description {
    margin-bottom: 1rem;
  }

  .gauge-display-note {
    padding: 0.75rem 1rem;
  }
}

@media (min-width: 641px) and (max-width: 1024px) {
  .gauge-page-header {
    padding: 1.25rem 1.5rem;
  }

  .gauge-display-metadata {
    padding: 1.5rem;
  }
}

@media (min-width: 1025px) {
  .gauge-page-header {
    padding: 1.5rem 2rem;
  }

  .gauge-display-metadata {
    padding: 2.5rem;
  }
}
